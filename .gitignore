# R&S proprietary firmware -- not ours to redistribute (only the placeholder READMEs are tracked)
/DISK1/*
!/DISK1/README.md
/DISK2/*
!/DISK2/README.md
/UPL_306.EXE
/ReadMe.txt

# generated test output (CSV/JSON results, self-test reports) -- scripts are
# the reusable part, not one session's numbers
/measurements/*.csv
/measurements/*.json
/measurements/*.txt
/upl_selftest_*.txt

# generated test WAVs (1.2 GB) -- rebuild with `python tools/testsignals.py`
/testsignals/

# per-unit identity and option key (DIAG:DEV dumps) -- never push these
/results/

# python
__pycache__/
*.pyc

# third-party manuals, app notes, test disc, option data, DUT docs -- see external/README.md.
# Only the placeholder READMEs are tracked.
/external/**
!/external/**/
!/external/**/README.md
